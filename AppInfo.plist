<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>Swipe up from + or hold the microphone to dictate a search. With OpenAI selected, the recording is sent to OpenAI for transcription when you release.</string>
	<!-- Lets the app ask whether Google Chrome is installed, for the translate
	     button on pages in another language. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>googlechromes</string>
		<string>googlechrome</string>
	</array>
	<!-- Keeps web audio and picture in picture going with the app in the
	     background. See BackgroundPlayback.swift. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- Lets animations run at up to 120 Hz on ProMotion iPhones. Without this,
	     iPhones cap an app's own animations at 60 Hz. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Registers orcabrowser:// so Shortcuts can hand control back to the app
	     after "Add Video to Play" finishes. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.liorschifrin.OrcaBrowser</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>orcabrowser</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
