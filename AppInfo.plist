<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets animations run at up to 120 Hz on ProMotion iPhones. Without this,
	     iPhones cap an app's own animations at 60 Hz. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Registers arcbrowser:// so Shortcuts can hand control back to the app
	     after "Add Video to Play" finishes. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.liorschifrin.ArcBrowser</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>arcbrowser</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
